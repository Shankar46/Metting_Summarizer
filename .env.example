# Required for the real pipeline.
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Providers
ASR_PROVIDER=groq_whisper
ASR_MODEL=whisper-large-v3
ASR_LANGUAGE=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Storage
DATABASE_URL=sqlite:///./data/meetings.db
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=100
TRANSCRIPT_CHUNK_CHARS=12000
TRANSCRIPT_MAX_CHARS=60000

LLM_MAX_ATTEMPTS=8
LLM_MAX_RATE_LIMIT_WAIT_SECONDS=120

# Frontend -> backend CORS
FRONTEND_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
